  "sql": "SELECT\n  COALESCE(NULLIF(TRIM(item.product_name), ''), '상품 미상') AS product_name,\n  COUNT(DISTINCT cs.record_id) AS processing_records,\n  SUM(item.quantity) AS total_item_quantity,\n  COUNTIF(item.quantity IS NULL) AS items_without_quantity\nFROM `skin1004-319714.cs_dashboard.domestic_cs_records` cs,\n  UNNEST(cs.items) item\nWHERE cs.received_at BETWEEN '2026-08-01' AND '2026-08-31'\nGROUP BY product_name\nORDER BY processing_records DESC, total_item_quantity DESC\nLIMIT 1000",

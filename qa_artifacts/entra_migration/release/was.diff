+    cur.execute(
+        "SELECT 1 AS present FROM INFORMATION_SCHEMA.TABLES "
+        "WHERE TABLE_SCHEMA = %s AND TABLE_NAME = %s AND TABLE_TYPE = 'BASE TABLE'",
+        (schema, table),
+    )
+    return bool(cur.fetchone())

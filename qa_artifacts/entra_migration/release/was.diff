+_SOURCE = "ad_users"
+_DIRECTORY = "directory_users"
+_MARKERS = "directory_migrations"
+_REQUIRED_COLUMNS = {
+    "id", "username", "display_name", "email", "department", "full_dn",
+    "is_active", "synced_at", "created_at", "updated_at", "deal_id_prefix",
+    "can_view_fi", "can_view_visitor_analytics",

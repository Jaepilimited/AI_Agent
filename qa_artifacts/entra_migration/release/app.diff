+
+def _find_person(cur, tenant: str, oid: str, email: str, *, graph_verified: bool = False) -> dict | None:
+    cur.execute("SELECT * FROM directory_users WHERE entra_tenant_id=%s AND entra_oid=%s "
+                "FOR UPDATE", (tenant, oid))

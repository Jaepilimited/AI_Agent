+def _decode_escaped_name(raw: str) -> str:
+    r"""가입할 때 `이주원` 같은 이스케이프를 되돌린다.
+
+    ⛔ 가입은 `directory_users.display_name` 을 **복사**한다. 그 순간 깨져 있으면 사본이
+       `users` 에 굳고, `directory_users` 가 나중에 고쳐져도 사본은 그대로다 — 로그인

+    ⚠️ 되돌릴 수 없으면 원본을 그대로 둔다 — 지어내지 않는다.
+    """
+    text = raw or ""
+    if "\\u" not in text:
+        return text
+    try:
+        decoded = text.encode("utf-8").decode("unicode_escape")
+    except Exception:
+        return text
+    if not decoded or "\\u" in decoded:
+        return text
+    return decoded

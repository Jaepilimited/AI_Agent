+    text = raw or ""
+    if "\\u" not in text:
+        return None
+    try:
+        decoded = text.encode("utf-8").decode("unicode_escape")
+    except Exception:
+        return None
+    if not decoded or "\\u" in decoded:
+        return None
+    return decoded
 
 

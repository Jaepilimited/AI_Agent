+@dataclass(frozen=True)
+class _ForeignKey:
+    schema: str
+    table: str
+    name: str
+    columns: tuple
+    referenced_schema: str
+    referenced_table: str
+    referenced_columns: tuple
+    delete_rule: str
+    update_rule: str

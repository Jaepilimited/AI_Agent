+.flow-map-lines { position: absolute; inset: 0; pointer-events: none; z-index: -1; }
+.flow-map-edge { stroke: #a7a7a2; stroke-width: 1.5; fill: none; transition: opacity .15s; }
+.flow-map-edge.is-support { stroke: #5a9b9d; stroke-dasharray: 5 5; }
+.flow-map-edge.is-active { stroke: #be7538; stroke-width: 2.5; }
+.flow-map-edge.is-support.is-active { stroke: #27878d; }
+.flow-map-edge.is-muted { opacity: .12; }
+.flow-map-node { position: absolute; display: flex; flex-direction: column; justify-content: center; gap: 3px; height: 74px; box-sizing: border-box; padding: 8px 10px; text-align: left; border: 1px solid var(--border-strong); border-radius: 11px; background: var(--bg-surface); color: var(--text); font: inherit; cursor: pointer; box-shadow: 0 3px 10px rgba(0,0,0,.035); transition: border-color .15s, opacity .15s, box-shadow .15s; }
+.flow-map-node-head { display: flex; align-items: center; justify-content: space-between; gap: 3px; }

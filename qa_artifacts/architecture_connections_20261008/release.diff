+.flow-map-models.is-focused { border-color: #27878d; box-shadow: 0 0 0 3px rgba(39,135,141,.13); }
+.flow-map-node.is-muted { opacity: .3; }
+.flow-map-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border); padding: 11px 20px; color: var(--text-secondary); font-size: 14px; line-height: 1.5; }
+.flow-map-scroll-hint { display: none; }
+@media (max-width: 1180px) { .flow-map-scroll-hint { display: inline; } }
+@media (prefers-reduced-motion: reduce) { .flow-map-node, .flow-map-edge { transition: none; } }
 #tab-flow .flow-hint { padding-top: 16px; margin-top: 16px; border-top: 1px solid var(--border); color: var(--text-secondary); font-size: 12px; line-height: 1.7; }
 @media (max-width: 1150px) {
   .flow-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }

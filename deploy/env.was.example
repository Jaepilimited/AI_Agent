# AI Craver — WAS(10.1.150.5) .env 템플릿
# 사용법: 이 파일을 WAS의 /home/jeffrey/AI_Agent/.env 로 복사 후 <...> 값 채우기.
# 실제 시크릿은 절대 Git에 커밋하지 말 것. 기존 Windows 서버의 .env에서 키를 옮겨온다.

# ── GCP / BigQuery ──
GCP_PROJECT_ID=skin1004-319714
# 서비스 계정 키를 Linux 경로로 이전 (예: /home/jeffrey/secrets/skin1004-319714.json, chmod 600)
GOOGLE_APPLICATION_CREDENTIALS=/home/jeffrey/secrets/skin1004-319714-60527c477460.json

# ── LLM ──
ANTHROPIC_API_KEY=<기존 .env에서 복사>
GEMINI_API_KEY=<기존 .env에서 복사>

# ── Notion ──
NOTION_MCP_TOKEN=<기존 .env에서 복사>
# TAVILY_API_KEY — 미사용 레거시 (웹검색은 Gemini Google Search grounding). 설정 불필요.

# ── Qdrant (노션 트리 벡터 검색) ──
# 방화벽에서 6333 오픈 전이면 클라우드 URL 접근 불가. self-host 전환 시 내부 URL로 교체.
QDRANT_URL=<https://bf41bcbe-....aws.cloud.qdrant.io:6333 또는 내부 Qdrant URL>
QDRANT_API_KEY=<기존 .env에서 복사 / self-host면 비움>

# ── Google OAuth (GWS 사용자별 인증) ──
GOOGLE_OAUTH_CLIENT_ID=<기존 .env에서 복사>
GOOGLE_OAUTH_CLIENT_SECRET=<기존 .env에서 복사>
# 새 도메인 확정 후 GCP 콘솔의 승인된 리디렉션 URI에도 동일하게 등록할 것
GOOGLE_OAUTH_REDIRECT_URI=https://ai.craver.local/auth/google/callback
GWS_DEFAULT_EMAIL=<기존 .env에서 복사>

# ── CS ──
CS_SPREADSHEET_ID=<기존 .env에서 복사>

# ── 인증/보안 (이관 시 신규 발급 — 커밋된 기본값 사용 금지) ──
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<신규 발급>
ANON_SALT=<신규 발급>
COOKIE_SECURE=true

# ── MariaDB → 신규 DB Server ──
MARIADB_HOST=10.1.200.5
MARIADB_PORT=3306
MARIADB_USER=ai
MARIADB_PASSWORD=<DB팀 전달값>
# 주의: DB명이 기존 skin1004_ai 에서 ai 로 변경됨 (덤프 복원 시 대상 DB 확인)
MARIADB_DATABASE=ai

# ── CORS (새 Web 도메인 확정 후 교체) ──
CORS_ORIGINS=https://ai.craver.local

# ── 레거시 (사용 여부 확인 후 제거 가능) ──
# SQLITE_DB_PATH=
# OPENWEBUI_DB_PATH=
# OPENWEBUI_SECRET_KEY=

# ── LDAP (WAS에서는 불필요 — AD sync는 App Server에서 실행) ──
# App Server의 .env에만 AD_SERVER/AD_USER/AD_PASSWORD/AD_SEARCH_BASE 설정
